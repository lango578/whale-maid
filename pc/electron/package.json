{
  "name": "whale-maid",
  "productName": "鲸鱼娘·汐汐",
  "version": "1.1.5",
  "description": "DeepSeek 女仆鲸鱼娘「汐汐」桌面伴侣 —— 聊天/陪玩/陪看/桌面悬浮",
  "main": "main.js",
  "author": "whalemaid",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "predist": "node copy-html.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.whalemaid.app",
    "productName": "鲸鱼娘汐汐",
    "files": [
      "main.js",
      "preload.js",
      "whale-maid-pc.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "鲸鱼娘·汐汐",
      "createDesktopShortcut": true
    }
  }
}
